; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are meant to be edited using the UI.
;
; R0 milestone: drive car_sedan.json on a flat static box, chase camera,
; tach/speed HUD, keyboard + gamepad input (PLAN.md 12's R0 scope).

config_version=5

[application]

config/name="racing_game R0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Mobile")
config/project_settings_override="user://renderer_override.cfg"
config/icon=""

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

[shader_globals]

rg_surface_detail={
"type": "int",
"value": 2
}
rg_origin_mod={
"type": "vec2",
"value": Vector2(0, 0)
}
rg_wetness={
"type": "float",
"value": 0.0
}
rg_puddles={
"type": "float",
"value": 0.0
}

[xr]

openxr/enabled=false
openxr/startup_alert=false
shaders/enabled=true
