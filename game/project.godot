; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are meant to be edited using the UI.
;
; R0 milestone: drive car_sedan.json on a flat static box, chase camera,
; tach/speed HUD, keyboard + gamepad input (PLAN.md 12's R0 scope).

config_version=5

[application]

config/name="racing_game R0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon=""

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[xr]

openxr/enabled=false
openxr/startup_alert=false
shaders/enabled=true
