    "cluster_track": "surface_cluster"
  },
  "lightness_distinct": {
    "min_lightness_difference": 18.0,
    "pairs": [["good", "danger"], ["warning", "danger"], ["pedal_brake", "pedal_throttle"], ["gauge_redline", "gauge_tick_major"]]
  },
  "simulated_vision": {
    "claim": "colour_blind_safe",
    "min_delta_e": 14.0,
    "pairs": [
      ["good", "danger"], ["good", "warning"], ["warning", "danger"], ["info", "danger"],
      ["good_text", "danger_text"], ["warning_text", "danger_text"],
      ["badge_good", "badge_danger"], ["gauge_redline", "gauge_tick_major"],
      ["chart_torque", "chart_power"], ["pedal_brake", "pedal_throttle"]
    ],
    "matrices": {
